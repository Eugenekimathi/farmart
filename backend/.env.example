# ── Core ──────────────────────────────────────────────────────────
# Production PostgreSQL database URL (Render PostgreSQL recommended)
DATABASE_URL=postgresql://user:password@host:5432/farmart
# Secret key for JWT signing — use a long random value in production
JWT_SECRET_KEY=your-secret-key-here
# Comma-separated list of allowed CORS origins (the Render frontend URL)
CORS_ORIGINS=https://farmart-frontend.onrender.com
# Public frontend URL (used for links/redirects in emails etc.)
FRONTEND_URL=https://farmart-frontend.onrender.com
# Port the web server listens on (Render injects this automatically)
PORT=5000

# ── Cloudinary image storage ─────────────────────────────────────
# Required for persistent production image uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Farmart Assistant (OpenAI) ───────────────────────────────
# Optional AI provider for Farmart Assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# ── M-Pesa Configuration ─────────────────────────────────────────
# Sandbox credentials by default; switch MPESA_ENVIRONMENT=live for production
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_PASSKEY=your-passkey
MPESA_SHORTCODE=your-shortcode
MPESA_ENVIRONMENT=sandbox
# Must be a publicly reachable HTTPS URL pointing to the Render backend callback
MPESA_CALLBACK_URL=https://farmart-backend.onrender.com/api/payments/callback

# ── Email (Gmail SMTP with App Password) ──────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
# The Gmail address that owns the App Password
MAIL_USERNAME=your-email@gmail.com
# The Gmail App Password (16 characters, no spaces)
MAIL_PASSWORD=your-app-password
# Default sender should normally be the same Gmail address as MAIL_USERNAME
MAIL_DEFAULT_SENDER=Farmart <your-email@gmail.com>