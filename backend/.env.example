DATABASE_URL=postgresql://user:password@localhost:5432/farmart
JWT_SECRET_KEY=your-secret-key-here
CORS_ORIGINS=http://localhost:5173

# Cloudinary image storage (optional locally; required for production uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional AI provider for Farmart Assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# M-Pesa Configuration (Optional - for payment integration)
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_PASSKEY=your-passkey
MPESA_SHORTCODE=your-shortcode
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=http://localhost:5000/api/payments/callback
